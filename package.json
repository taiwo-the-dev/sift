{
  "name": "sift",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --conditions=react-server --import tsx --test tests/**/*.test.ts",
    "index:agents": "node --conditions=react-server --import tsx scripts/index-agents.ts bootstrap",
    "sync:agents": "node --conditions=react-server --import tsx scripts/index-agents.ts incremental",
    "index:smoke": "node --conditions=react-server --import tsx scripts/index-agents.ts smoke",
    "db:link": "supabase link",
    "db:migrations": "supabase migration list --linked",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > lib/db/database.generated.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@next/env": "16.3.1",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.55.19",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
