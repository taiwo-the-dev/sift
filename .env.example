# Canonical public origin used for metadata and sharing URLs outside Vercel.
# Use an HTTPS origin without a path, for example https://sift.example.
SIFT_SITE_URL=

# Server-only Supabase Data API connection used by database repositories.
# Copy the HTTPS Project URL from the hosted project's Connect dialog.
SUPABASE_URL=

# Copy a Supabase secret key (`sb_secret_...`) from Settings > API Keys.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a populated key.
SUPABASE_SECRET_KEY=

# Sift Indexer network for a single local/manual run. BSC Testnet is the safe
# development default; the scheduled workflow runs mainnet and testnet as
# isolated jobs with separate checkpoints.
BNB_NETWORK=bsc-testnet

# M8/M9 browser wallet configuration. NEXT_PUBLIC_ values are intentionally sent
# to browsers and must never contain server RPC secrets or private credentials.
# A free WalletConnect Cloud project ID enables QR/mobile wallet connections.
# Without it, Sift still supports installed injected browser wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional browser-safe RPC overrides. Public/free BNB endpoints are used as
# ordered fallbacks when these are blank or when an override is unavailable.
NEXT_PUBLIC_BNB_TESTNET_RPC_URL=
NEXT_PUBLIC_BNB_MAINNET_RPC_URL=

# Optional ordered RPC overrides. Use a private free-tier URL through GitHub
# Actions secrets when a provider includes a token. Never commit RPC tokens.
BNB_RPC_PRIMARY=
BNB_RPC_FALLBACK_1=
BNB_RPC_FALLBACK_2=

# GitHub Actions uses network-specific variants of the three RPC secrets above:
# BNB_MAINNET_RPC_PRIMARY / _FALLBACK_1 / _FALLBACK_2
# BNB_TESTNET_RPC_PRIMARY / _FALLBACK_1 / _FALLBACK_2
# A BSC mainnet bootstrap requires a free-tier archive endpoint that supports
# historical eth_getLogs; public BNB endpoints intentionally do not.

# Optional indexer tuning. Verified network defaults are used when blank.
ERC8004_REGISTRY_ADDRESS=
ERC8004_DEPLOYMENT_BLOCK=
INDEXER_BATCH_SIZE=
INDEXER_MIN_BATCH_SIZE=
INDEXER_CONFIRMATIONS=
INDEXER_RPC_TIMEOUT_MS=
INDEXER_METADATA_TIMEOUT_MS=
INDEXER_METADATA_MAX_BYTES=
INDEXER_METADATA_RETRIES=
INDEXER_METADATA_CONCURRENCY=
IPFS_GATEWAY_URL=

# M6 bounded server-side health assessment. Defaults are free-tier conscious.
HEALTH_CHECK_LIMIT=
HEALTH_CHECK_CONCURRENCY=
HEALTH_CHECK_INTERVAL_HOURS=
HEALTH_CHECK_TIMEOUT_MS=
HEALTH_CHECK_RETRIES=
HEALTH_CHECK_MAX_BYTES=

# Maximum affected agents recalculated per scoring run (default 200, max 500).
SCORE_BATCH_LIMIT=

# Optional server-only 8004scan API key used to cross-check the 12-agent M14
# shortlist. Core discovery remains available without it. Never use a
# NEXT_PUBLIC_ prefix or commit the real value.
SIFT_8004SCAN_API_KEY=
