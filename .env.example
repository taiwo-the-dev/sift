# Server-only Supabase Data API connection used by database repositories.
# Use the API URL shown by `supabase status` locally or the project Connect dialog.
SUPABASE_URL=

# Use a Supabase secret key (`sb_secret_...`) in hosted environments.
# For the local stack, map the local server/service-role credential here.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a populated key.
SUPABASE_SECRET_KEY=
